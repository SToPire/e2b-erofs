# Applied to the pinned 6.1.177 x86_64 config; resolve with olddefconfig.
CONFIG_LOCALVERSION="-e2b-pmem-overlay-v1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_ZONE_DEVICE=y
CONFIG_LIBNVDIMM=y
CONFIG_VIRTIO_PMEM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_ND_CLAIM=y
CONFIG_ND_PFN=y
CONFIG_NVDIMM_PFN=y
CONFIG_NVDIMM_DAX=y
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_FS_DAX_PMD=y
